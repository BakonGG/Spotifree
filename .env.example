# =============================================================================
# SPOTYFREE — Exemplo de Variáveis de Ambiente
# =============================================================================
# Copie este arquivo para ".env" e preencha os valores.
# O arquivo ".env" está no .gitignore e NUNCA deve ser commitado.
# Para o deploy na Vercel, configure estas variáveis em:
# Vercel → Project → Settings → Environment Variables
# =============================================================================


# -----------------------------------------------------------------------------
# SPOTIFY API
# Crie seu app em: https://developer.spotify.com/dashboard → Create App
# -----------------------------------------------------------------------------

VITE_SPOTIFY_CLIENT_ID=seu_spotify_client_id_aqui
SPOTIFY_CLIENT_SECRET=seu_spotify_client_secret_aqui


# -----------------------------------------------------------------------------
# DISCORD OAUTH
# Crie em: https://discord.com/developers/applications → New Application → OAuth2
# Redirect URL a configurar lá: https://SEU-PROJETO.vercel.app/api/auth/callback/discord
# -----------------------------------------------------------------------------

DISCORD_CLIENT_ID=seu_discord_client_id_aqui
DISCORD_CLIENT_SECRET=seu_discord_client_secret_aqui


# -----------------------------------------------------------------------------
# GITHUB OAUTH
# Crie em: https://github.com/settings/developers → OAuth Apps → New OAuth App
# Homepage URL: https://SEU-PROJETO.vercel.app
# Callback URL: https://SEU-PROJETO.vercel.app/api/auth/callback/github
# -----------------------------------------------------------------------------

GITHUB_CLIENT_ID=seu_github_client_id_aqui
GITHUB_CLIENT_SECRET=seu_github_client_secret_aqui


# -----------------------------------------------------------------------------
# AUTH BACKEND (better-auth)
# -----------------------------------------------------------------------------

# Em desenvolvimento: http://localhost:5173
# Em produção: https://SEU-PROJETO.vercel.app
AUTH_BASE_URL=http://localhost:8888
VITE_AUTH_BASE_URL=https://spotifree2.netlify.app

# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=uma_string_aleatoria_longa_de_pelo_menos_32_caracteres


# -----------------------------------------------------------------------------
# DATABASE (PocketBase — opcional)
# -----------------------------------------------------------------------------

POCKETBASE_URL=https://seu-pocketbase.exemplo.com


# -----------------------------------------------------------------------------
# SENTRY (monitoramento de erros — opcional)
# -----------------------------------------------------------------------------

VITE_SENTRY_DSN=https://xxxx@oyyy.ingest.sentry.io/zzzz


# -----------------------------------------------------------------------------
# AMBIENTE
# -----------------------------------------------------------------------------

NODE_ENV=development
